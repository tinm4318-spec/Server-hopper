local function makeRow(server, idx)
    local playing = tonumber(server.playing) or 0
    local maxP = tonumber(server.maxPlayers) or 0
    local isFull = playing >= maxP
    local isCurrent = server.id == game.JobId
    local isPrev = supportsFiles and server.id == STATE.prevServerId

    if STATE.hideFull and isFull and not isCurrent then return end
    if STATE.hideCurrent and isCurrent then return end

    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = C.row,
        BorderSizePixel = 0,
        LayoutOrder = idx,
    }, scroll)
    corner(row, 8)
    stroke(row, C.stroke, 1)

    -- accent bar
    local accentCol = C.accent
    if isCurrent then accentCol = Color3.fromRGB(80, 120, 220)
    elseif isPrev then accentCol = C.warn
    elseif isFull then accentCol = Color3.fromRGB(80, 80, 80) end

    local accentBar = make("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.fromOffset(0, 8),
        BackgroundColor3 = accentCol,
        BorderSizePixel = 0,
    }, row)
    corner(accentBar, 2)

    -- server id (mono-ish, truncated)
    local idLabel = make("TextLabel", {
        Size = UDim2.new(1, -160, 0, 16),
        Position = UDim2.fromOffset(14, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.text,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(server.id),
    }, row)

    -- tags
    local tagText = ""
    if isCurrent then tagText = "you"
    elseif isPrev then tagText = "last" end

    local tagLabel = make("TextLabel", {
        Size = UDim2.new(1, -160, 0, 14),
        Position = UDim2.fromOffset(14, 26),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.subtext,
        Text = tagText ~= "" and (tagText .. " · " .. playing .. "/" .. maxP) or (playing .. "/" .. maxP),
    }, row)

    -- capacity mini-bar
    local barBG = make("Frame", {
        Size = UDim2.new(0, 90, 0, 6),
        Position = UDim2.new(1, -160, 0, 10),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, row)
    corner(barBG, 3)

    local ratio = maxP > 0 and math.clamp(playing / maxP, 0, 1) or 0
    local barFill = make("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = ratio >= 1 and C.danger or C.fill,
        BorderSizePixel = 0,
    }, barBG)
    corner(barFill, 3)

    -- join button
    local joinBtn = make("TextButton", {
        Size = UDim2.new(0, 84, 0, 34),
        Position = UDim2.new(1, -148, 0.5, -17),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.accent,
        Text = isCurrent and "current" or "join",
    }, row)
    corner(joinBtn, 6)
    stroke(joinBtn, C.stroke, 1)

    if isCurrent then
        joinBtn.TextColor3 = C.subtext
        joinBtn.Active = false
    end

    joinBtn.MouseEnter:Connect(function()
        if isCurrent then return end
        TweenService:Create(joinBtn, TweenInfo.new(0.12), {
            BackgroundColor3 = C.accentDim, TextColor3 = C.text
        }):Play()
    end)
    joinBtn.MouseLeave:Connect(function()
        if isCurrent then return end
        TweenService:Create(joinBtn, TweenInfo.new(0.12), {
            BackgroundColor3 = C.panel, TextColor3 = C.accent
        }):Play()
    end)

    if not isCurrent then
        joinBtn.MouseButton1Click:Connect(function()
            setStatus("hopping…", C.warn)
            joinBtn.Text = "…"
            task.spawn(function()
                pcall(function()
                    if queueTeleport then
                        queueTeleport(game:HttpGetAsync("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source").sub(1, 0)) -- no-op placeholder
                    end
                end)
                local ok, err = pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LP)
                end)
                if not ok then
                    setStatus("hop failed", C.danger)
                    joinBtn.Text = "join"
                end
            end)
        end)
    end

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundColor3 = C.rowHover }):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundColor3 = C.row }):Play()
    end)

    return row
end

local function renderRows()
    clearRows()
    emptyLabel.Visible = false

    if not STATE.servers or #STATE.servers == 0 then
        emptyLabel.Visible = true
        countLabel.Text = "0 servers"
        return
    end

    local shown = 0
    for i, s in ipairs(STATE.servers) do
        if type(s) == "table" and s.id and s.playing and s.maxPlayers then
            local before = #scroll:GetChildren()
            makeRow(s, i)
            if #scroll:GetChildren() > before then shown += 1 end
        end
    end

    countLabel.Text = string.format("%d / %d shown", shown, #STATE.servers)
end

-- ==== fetch ====
local function fetchServers()
    if STATE.updating then return end
    STATE.updating = true
    setStatus("fetching…", C.warn)
    refreshBtn.Text = "…"

    task.spawn(function()
        local order = STATE.ascending and "Asc" or "Desc"
        local collected = {}
        local cursor = ""
        local pages = 0
        local maxPages = 10 -- 10 x 100 = up to 1000 cap, but we trim to STATE.maxServers

        while pages < maxPages do
            pages += 1
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100%s")
                :format(game.PlaceId, order, cursor ~= "" and ("&cursor=" .. cursor) or "")

            local body
            local ok = pcall(function()
                if request then
                    local res = request({ Url = url, Method = "GET" })
                    body = res and res.Body
                end
            end)

            if not body then
                local ok2, res2 = pcall(function() return game:HttpGet(url) end)
                if ok2 then body = res2 end
            end

            if not body then
                setStatus("rate limited", C.danger)
                break
            end

            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if not decodeOk or not decoded or not decoded.data then
                setStatus("bad response", C.danger)
                break
            end

            for _, srv in ipairs(decoded.data) do
                if type(srv) == "table" and srv.id and srv.playing and srv.maxPlayers then
                    table.insert(collected, srv)
                end
            end

            if #collected >= STATE.maxServers then break end

            cursor = decoded.nextPageCursor
            if not cursor or cursor == "" then break end
            task.wait(0.6) -- be gentle; the endpoint is picky
        end

        -- trim
        while #collected > STATE.maxServers do
            table.remove(collected)
        end

        -- sort by player count matching direction
        table.sort(collected, function(a, b)
            local pa = tonumber(a.playing) or 0
            local pb = tonumber(b.playing) or 0
            if STATE.ascending then return pa < pb else return pa > pb end
        end)

        STATE.servers = collected
        STATE.lastUpdate = os.time()
        STATE.updating = false
        refreshBtn.Text = "Refresh"
        setStatus("ready", C.accent)
        renderRows()
    end)
end

