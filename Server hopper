-- 执行器兼容 shim（避免 "attempt to call a nil value"）
local function safeSpawn(fn, ...)
	if type(task) == "table" and task.spawn then return task.spawn(fn, ...) end
	if type(spawn) == "function" then return spawn(fn, ...) end
	return coroutine.wrap(function() fn(...) end)()
end
local function safeWait(n)
	if type(task) == "table" and task.wait then return task.wait(n) end
	if type(wait) == "function" then return wait(n) end
	return 0
end
local function safeRequest(opts)
	local env = getfenv()
	for _, fn in ipairs({ rawget(env, "request"), rawget(env, "http_request") }) do
		if type(fn) == "function" then
			local ok, res = pcall(fn, opts)
			if ok and type(res) == "table" then return res end
		end
	end
	return nil
end
local function httpGet(url)
	local res = safeRequest({ Url = url, Method = "GET" })
	if res and res.Body then return res.Body end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" then return body end
	return nil
end

