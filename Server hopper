local function makeServerRow(parent, server, idx)
    local playing   = tonumber(server.playing) or 0
    local maxP      = tonumber(server.maxPlayers) or 0
    local isFull    = playing >= maxP
    local isCurrent = server.id == game.JobId
    local isPrev    = supportsFiles and server.id == State.prevServerId

    if State.hideFull and isFull and not isCurrent then return end
    if State.hideCurrent and isCurrent then return end

    local row = make("Frame", {
        Name = "Row_" .. idx,
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = C.row,
        BorderSizePixel = 0,
        LayoutOrder = idx,
    }, parent)
    corner(row, 4)
    stroke(row, C.stroke, 1)

    -- accent bar: white for normal, grey for full/prev, bright white for current
    local accentCol = C.accent
    if isCurrent then accentCol = Color3.fromRGB(255, 255, 255)
    elseif isPrev then accentCol = C.warn
    elseif isFull then accentCol = Color3.fromRGB(80, 80, 80) end

    local bar = make("Frame", {
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.fromOffset(0, 6),
        BackgroundColor3 = accentCol,
        BorderSizePixel = 0,
    }, row)
    corner(bar, 2)

    make("TextLabel", {
        Size = UDim2.new(1, -110, 0, 18),
        Position = UDim2.fromOffset(14, 6),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextColor3 = C.text,
        Text = tostring(server.id),
    }, row)

    local tag = ""
    if isCurrent then tag = "you · "
    elseif isPrev then tag = "last · " end

    make("TextLabel", {
        Size = UDim2.new(1, -110, 0, 16),
        Position = UDim2.fromOffset(14, 24),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.subtext,
        Text = tag .. playing .. "/" .. maxP,
    }, row)

    local joinBtn = make("TextButton", {
        Size = UDim2.fromOffset(84, 30),
        Position = UDim2.new(1, -92, 0.5, -15),
        BackgroundColor3 = C.rowHover,
        BorderSizePixel = 0,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextColor3 = isCurrent and C.subtext or C.accent,
        Text = isCurrent and "current" or "join",
        AutoButtonColor = false,
    }, row)
    corner(joinBtn, 4)
    stroke(joinBtn, C.stroke, 1)

    if not isCurrent then
        joinBtn.MouseButton1Click:Connect(function()
            joinBtn.Text = "…"
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LP)
            end)
            if not ok then
                joinBtn.Text = "join"
            end
        end)
    end
end

local function renderServers()
    clearRows()
    if #State.servers == 0 then
        countLbl.Text = "0 servers - press refresh"
        return
    end
    local shown = 0
    for i, s in ipairs(State.servers) do
        if type(s) == "table" and s.id and s.playing and s.maxPlayers then
            local before = 0
            for _, ch in ipairs(listInner:GetChildren()) do
                if ch:IsA("Frame") then before = before + 1 end
            end
            makeServerRow(listInner, s, i)
            local after = 0
            for _, ch in ipairs(listInner:GetChildren()) do
                if ch:IsA("Frame") then after = after + 1 end
            end
            if after > before then shown = shown + 1 end
        end
    end
    countLbl.Text = string.format("%d / %d servers", shown, #State.servers)
end

local function fetchServers()
    if State.updating then return end
    State.updating = true
    refreshBtn.Text = "Refreshing..."
    refreshBtn.TextColor3 = C.accent

    task.spawn(function()
        local order = State.ascending and "Asc" or "Desc"
        local collected = {}
        local cursor = ""
        local pages = 0
        local maxPages = 10
        local failed = false

        while pages < maxPages do
            pages = pages + 1
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100%s")
                :format(game.PlaceId, order, cursor ~= "" and ("&cursor=" .. cursor) or "")

            local body
            pcall(function()
                if request then
                    local res = request({ Url = url, Method = "GET" })
                    body = res and res.Body
                end
            end)
            if not body then
                pcall(function() body = game:HttpGet(url) end)
            end
            if not body then
                failed = true
                break
            end

            local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
            if not ok or not decoded or not decoded.data then
                failed = true
                break
            end

            for _, srv in ipairs(decoded.data) do
                if type(srv) == "table" and srv.id and srv.playing and srv.maxPlayers then
                    table.insert(collected, srv)
                end
            end
            if #collected >= State.maxServers then break end

            cursor = decoded.nextPageCursor
            if not cursor or cursor == "" then break end
            task.wait(0.6)
        end

        while #collected > State.maxServers do
            table.remove(collected)
        end

        table.sort(collected, function(a, b)
            local pa = tonumber(a.playing) or 0
            local pb = tonumber(b.playing) or 0
            if State.ascending then return pa < pb else return pa > pb end
        end)

        State.servers = collected
        State.updating = false
        if failed then
            refreshBtn.Text = "Rate limited / failed"
            refreshBtn.TextColor3 = C.danger
            task.wait(1.5)
        end
        refreshBtn.Text = "Refresh Servers"
        refreshBtn.TextColor3 = C.text
        renderServers()
    end)
end

refreshBtn.MouseButton1Click:Connect(fetchServers)

sortBtn.MouseButton1Click:Connect(function()
    State.ascending = not State.ascending
    sortBtn.Text = State.ascending and "Sort: Asc" or "Sort: Desc"
