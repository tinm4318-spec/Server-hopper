local uiScale = make("UIScale", { Scale = 1 }, root)
local function fitScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local inset = GuiService:GetGuiInset()
    local usableW = vp.X
    local usableH = vp.Y - inset.Y - inset.Y
    local m = 16
    local sX = (usableW - m * 2) / BASE_W
    local sY = (usableH - m * 2) / BASE_H
    -- floor raised from 0.55 -> 0.70 so it stays large on phones
    local s = math.clamp(math.min(sX, sY, 1), 0.70, 1)
    uiScale.Scale = s
end
fitScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if not State.destroyed then fitScale() end
end)

