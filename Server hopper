-- UIScale so the whole thing fits mobile
local uiScale = make("UIScale", { Scale = 1 }, root)
local function fitScale()
    local vp = workspace.CurrentCamera.ViewportSize
    local inset = GuiService:GetGuiInset()
    local usableW = vp.X
    local usableH = vp.Y - inset.Y - inset.Y
    local margin = 24
    local scaleX = (usableW - margin * 2) / BASE_W
    local scaleY = (usableH - margin * 2) / BASE_H
    local s = math.clamp(math.min(scaleX, scaleY, 1), 0.5, 1)
    uiScale.Scale = s
end
fitScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if not STATE.destroyed then fitScale() end
end)

