local function setActive(page)
    mainPage.Visible     = page == "main"
    serversPage.Visible  = page == "servers"
    settingsPage.Visible = page == "settings"

    mainPG.BackgroundColor3     = page == "main"     and C.rowActive or C.sidebar
    serversPG.BackgroundColor3  = page == "servers"  and C.rowActive or C.sidebar
    settingsPG.BackgroundColor3 = page == "settings" and C.rowActive or C.sidebar

    mainPG.TextColor3     = page == "main"     and C.accent or C.subtext
    serversPG.TextColor3  = page == "servers"  and C.accent or C.subtext
    settingsPG.TextColor3 = page == "settings" and C.accent or C.subtext
end

mainPG.MouseButton1Click:Connect(function() setActive("main") end)
serversPG.MouseButton1Click:Connect(function() setActive("servers") end)
settingsPG.MouseButton1Click:Connect(function() setActive("settings") end)

-- ============================================================
-- MINIMIZE
-- ============================================================
local minimized = false
minimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    sidebar.Visible = not minimized
    content.Visible = not minimized
    if minimized then
        root.Size = UDim2.new(0, BASE_W, 0, TOP_H)
        minimizeBtn.Text = "+"
    else
        root.Size = UDim2.fromOffset(BASE_W, BASE_H)
        minimizeBtn.Text = "-"
    end
end)

-- ============================================================
-- LIVE TITLE + INFO
-- ============================================================
local smoothedFPS = 60
local lastFrameT  = tick()
RunService.RenderStepped:Connect(function()
    local now = tick()
    local dt = now - lastFrameT
    lastFrameT = now
    if dt > 0 then
        smoothedFPS = smoothedFPS + ((1 / dt) - smoothedFPS) * 0.05
    end
end)

local startTime = tick()

task.spawn(function()
    while not State.destroyed and gui.Parent do
        local ping   = math.floor((LP:GetNetworkPing() or 0) * 1000)
        local pcount = #Players:GetPlayers()
        local pmax   = Players.MaxPlayers
        title.Text = string.format(
            "BLACKOUT HOP  |  fps: %d  |  ping: %dms  |  %d/%d",
            math.floor(smoothedFPS), ping, pcount, pmax
        )
        task.wait(0.5)
    end
end)

task.spawn(function()
    while not State.destroyed and gui.Parent do
        local ping   = math.floor((LP:GetNetworkPing() or 0) * 1000)
        local pcount = #Players:GetPlayers()
        local pmax   = Players.MaxPlayers
        local uptime = math.floor(tick() - startTime)
        playersLbl.Text = string.format("Players: %d/%d", pcount, pmax)
        pingLbl.Text    = string.format("Ping: %dms", ping)
        uptimeLbl.Text  = string.format("Uptime: %ds", uptime)
        task.wait(1)
    end
end)

-- ============================================================
-- AUTO REFRESH LOOP
-- ============================================================
task.spawn(function()
    while not State.destroyed and gui.Parent do
        task.wait(60)
        if State.autoRefresh and not State.updating then
            fetchServers()
        end
    end
end)

-- ============================================================
-- SPLASH (black, white border, fades)
-- ============================================================
local splash = make("Frame", {
    Size = UDim2.fromOffset(400, 130),
    Position = UDim2.new(0.5, -200, 0.5, -65),
    BackgroundColor3 = C.bg,
    BorderSizePixel = 0,
    ZIndex = 999,
}, gui)
corner(splash, 8)
stroke(splash, C.accent, 1)

local splashTitle = make("TextLabel", {
    Size = UDim2.new(1, 0, 0, 60),
    Position = UDim2.fromOffset(0, 20),
    BackgroundTransparency = 1,
    Font = Enum.Font.Code,
    TextSize = 34,
    TextColor3 = C.accent,
    Text = "BLACKOUT HOP",
}, splash)

local splashSub = make("TextLabel", {
    Size = UDim2.new(1, 0, 0, 24),
    Position = UDim2.new(0, 0, 1, -30),
    BackgroundTransparency = 1,
    Font = Enum.Font.Code,
    TextSize = 13,
    TextColor3 = C.subtext,
    Text = "loading hop spine...",
}, splash)

task.delay(1.2, function()
    if State.destroyed then return end
    local t1 = TweenService:Create(splash,      TweenInfo.new(0.5), { BackgroundTransparency = 1 })
    local t2 = TweenService:Create(splashTitle, TweenInfo.new(0.5), { TextTransparency = 1 })
    local t3 = TweenService:Create(splashSub,   TweenInfo.new(0.5), { TextTransparency = 1 })
    t1:Play(); t2:Play(); t3:Play()
    t1.Completed:Wait()
    if splash and splash.Parent then splash:Destroy() end
end)

-- ============================================================
-- BOOT
-- ============================================================
setActive("main")
task.wait(0.1)
fetchServers()
