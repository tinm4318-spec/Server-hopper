local cachedServers = {}
local function fetchServers()
	local url = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100",
		game.PlaceId
	)
	local body = httpGet(url)
	if not body then return nil, "网络错误" end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
		return nil, "被限流，稍等再试"
	end
	local list = {}
	for _, v in ipairs(decoded.data) do
		if v.id and v.playing and v.maxPlayers then
			table.insert(list, {
				id = v.id,
				playing = tonumber(v.playing) or 0,
				max = tonumber(v.maxPlayers) or 0,
				ping = tonumber(v.ping) or 0,
			})
		end
	end
	table.sort(list, function(a, b)
		if a.playing == b.playing then return a.ping < b.ping end
		return a.playing > b.playing
	end)
	return list, nil
end

local function renderServers(list)
	for _, ch in ipairs(serverList:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end
	if not list or #list == 0 then
		local e = Instance.new("TextLabel", serverList)
		e.Text = "没有找到服务器"
		e.TextColor3 = C.textDim
		e.TextSize = 12
		e.FontFace = FONT
		e.BackgroundTransparency = 1
		e.Size = UDim2.new(1, 0, 0, 24)
		return
	end
	for i, s in ipairs(list) do
		local row = Instance.new("TextButton", serverList)
		row.BackgroundColor3 = C.panel
		row.BorderSizePixel = 0
		row.Text = ""
		row.AutoButtonColor = false
		row.Size = UDim2.new(1, 0, 0, 34)
		row.LayoutOrder = i
		corner(row, 6); stroke(row)

		local lbl = Instance.new("TextLabel", row)
		lbl.BackgroundTransparency = 1
		lbl.Text = string.format("%d/%d · 延迟 %d", s.playing, s.max, s.ping)
		lbl.TextColor3 = C.text
		lbl.TextSize = 12
		lbl.FontFace = FONT
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Size = UDim2.new(1, -80, 1, 0)
		lbl.Position = UDim2.new(0, 10, 0, 0)

		local join = Instance.new("TextButton", row)
		join.Text = "加入"
		join.TextSize = 12
		join.TextColor3 = C.bg
		join.BackgroundColor3 = C.accent
		join.BorderSizePixel = 0
		join.FontFace = FONT
		join.Size = UDim2.new(0, 60, 0, 22)
		join.Position = UDim2.new(1, -70, 0.5, -11)
		corner(join, 5)

		join.MouseButton1Click:Connect(function()
			if s.id == game.JobId then
				hopStatus.Text = "已经在这个服务器"
				hopStatus.TextColor3 = C.danger
				return
			end
			hopStatus.Text = "传送中..."
			hopStatus.TextColor3 = C.accent
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
			end)
		end)
	end
end

refreshBtn.MouseButton1Click:Connect(function()
	hopStatus.Text = "获取服务器中..."
	hopStatus.TextColor3 = C.textDim
	safeSpawn(function()
		local list, err = fetchServers()
		if err then
			hopStatus.Text = err
			hopStatus.TextColor3 = C.danger
			return
		end
		cachedServers = list
		hopCount.Text = string.format("服务器: %d", #list)
		hopStatus.Text = "就绪"
		hopStatus.TextColor3 = C.good
		renderServers(list)
	end)
end)

hopBtn.MouseButton1Click:Connect(function()
	if #cachedServers == 0 then
		hopStatus.Text = "先点刷新"
		hopStatus.TextColor3 = C.danger
		return
	end
	for _, s in ipairs(cachedServers) do
		if s.id ~= game.JobId then
