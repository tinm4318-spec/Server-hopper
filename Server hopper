local function buttonRow(parent, name, label, order, onClick)
    local btn = make("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 28),
        LayoutOrder = order,
        BackgroundColor3 = C.row,
        BorderSizePixel = 0,
