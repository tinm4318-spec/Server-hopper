    local function watchForNewItem(baseline, excluded)
        local state = { done = false, conns = {} }
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        local ch = LocalPlayer.Character
        local function check(item)
            if state.done then
                return
            end
            if not item:IsA("Tool") then
                return
            end
            for _, ex in ipairs(excluded) do
                if item.Name == ex then
                    return
                end
            end
            if countTool(item.Name) > (baseline[item.Name] or 0) then
                state.done = true
            end
        end
        if bp then
            table.insert(state.conns, bp.ChildAdded:Connect(check))
        end
        if ch then
            table.insert(state.conns, ch.ChildAdded:Connect(check))
        end
        function state:Stop()
            for _, c in ipairs(self.conns) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            self.conns = {}
        end
        return state
    end

    local function stealWithBucket(targetPlayer)
        local character = LocalPlayer.Character
        if not character then
            EnlightenNotify("Character missing.")
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not hrp then
            EnlightenNotify("Character parts missing.")
            return
        end
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local bucket = character:FindFirstChild("BlueBucket") or (backpack and backpack:FindFirstChild("BlueBucket"))
        if not bucket then
            EnlightenNotify("BlueBucket not found.")
            return
        end
        if not targetPlayer or not targetPlayer.Character then
            EnlightenNotify("Target not ready.")
            return
        end
        local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not targetHrp then
            EnlightenNotify("Target HRP missing.")
            return
        end

        local originalCFrame = hrp.CFrame
        local baseline = snapshotInventory()

        if bucket.Parent ~= character then
            pcall(function()
                humanoid:EquipTool(bucket)
            end)
        end
        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 2.5)
        RunService.Heartbeat:Wait()

        local watcher = watchForNewItem(baseline, {"BlueBucket"})
        pcall(function()
            if bucket and bucket.Parent then
                bucket:Activate()
            end
        end)

        local t0 = os.clock()
        while os.clock() - t0 < 4 and not watcher.done do
            RunService.Heartbeat:Wait()
        end
        watcher:Stop()

        local ch = LocalPlayer.Character
        local curHrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if curHrp and curHrp.Parent then
            curHrp.CFrame = originalCFrame
        end

        if watcher.done then
            EnlightenNotify("Bucket success — tp back.")
        else
            EnlightenNotify("Bucket timeout.")
        end
    end

