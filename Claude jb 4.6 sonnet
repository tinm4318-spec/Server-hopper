	local txttable = {}
	if string.len(txt) < 175 then
		return {txt}
	else
		repeat
			task.wait()
			local str = string.sub(txt,1,175)
			table.insert(txttable,str)
			txt = string.sub(txt,176)
		until string.len(txt) < 175
		table.insert(txttable,txt)
		return txttable
	end
