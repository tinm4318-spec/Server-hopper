playerMouse.Button1Down:Connect(function()
	if not gui.Enabled then return end
	local hitPart = playerMouse.Target
	if hitPart and hitPart:IsDescendantOf(workspace.Bricks) and selectedPart ~= hitPart then
		clearSelection()
		selectedPart = hitPart

		ghostPart = selectedPart:Clone()
		ghostPart.Size        = ghostPart.Size + Vector3.new(0.01, 0.01, 0.01)
		ghostPart.Transparency = 0.5
		ghostPart.Anchored     = true
		ghostPart.CanCollide   = false
		ghostPart.Parent       = workspace

		handlePart = selectedPart:Clone()
		handlePart.Size        = selectedPart.Size + Vector3.new(0.01, 0.01, 0.01)
		handlePart.Transparency = 1
		handlePart.Anchored    = true
		handlePart.CanCollide  = false
		handlePart.Parent      = workspace

		selectionBox.Adornee = ghostPart
		arcHandles.Adornee   = handlePart

		local rx, ry, rz = selectedPart.CFrame:ToEulerAnglesXYZ()
		axisframe.X.TextBox.Text = tostring(math.round(math.deg(rx)))
		axisframe.Y.TextBox.Text = tostring(math.round(math.deg(ry)))
		axisframe.Z.TextBox.Text = tostring(math.round(math.deg(rz)))
	end
end)

arcHandles.MouseButton1Down:Connect(function(axis)
	if not handlePart then return end
	dragStartCFrame  = handlePart.CFrame
	arcHandles.Axes  = Axes.new(axis)
end)

arcHandles.MouseDrag:Connect(function(axis, relativeAngle)
	if not ghostPart or not dragStartCFrame then return end
	local snapped = math.rad(math.round(math.deg(relativeAngle) / snapAngle) * snapAngle)
	local rx, ry, rz = 0, 0, 0
	if axis == Enum.Axis.X then rx = snapped
	elseif axis == Enum.Axis.Y then ry = snapped
	elseif axis == Enum.Axis.Z then rz = snapped end
	local newCFrame = dragStartCFrame * CFrame.Angles(rx, ry, rz)
	ghostPart.CFrame = newCFrame
	handlePart.CFrame = newCFrame
	local rx2, ry2, rz2 = newCFrame:ToEulerAnglesXYZ()
	axisframe.X.TextBox.Text = tostring(math.round(math.deg(rx2)))
	axisframe.Y.TextBox.Text = tostring(math.round(math.deg(ry2)))
	axisframe.Z.TextBox.Text = tostring(math.round(math.deg(rz2)))
end)

arcHandles.MouseButton1Up:Connect(function()
	arcHandles.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z)
end)

local function applyTextBoxRotation()
	if not ghostPart or not selectedPart then return end
	local rx = math.rad(tonumber(axisframe.X.TextBox.Text) or 0)
	local ry = math.rad(tonumber(axisframe.Y.TextBox.Text) or 0)
	local rz = math.rad(tonumber(axisframe.Z.TextBox.Text) or 0)
	local newCFrame = CFrame.new(ghostPart.Position) * CFrame.Angles(rx, ry, rz)
	ghostPart.CFrame  = newCFrame
	handlePart.CFrame = newCFrame
	local frx, fry, frz = newCFrame:ToEulerAnglesXYZ()
	axisframe.X.TextBox.Text = tostring(math.round(math.deg(frx)))
	axisframe.Y.TextBox.Text = tostring(math.round(math.deg(fry)))
	axisframe.Z.TextBox.Text = tostring(math.round(math.deg(frz)))
end

for _, axisname in ipairs({"X", "Y", "Z"}) do
	axisframe[axisname].TextBox.FocusLost:Connect(function()
		local num = tonumber(axisframe[axisname].TextBox.Text)
		if num then
			axisframe[axisname].TextBox.Text = tostring(math.round(num) % 360)
		else
			axisframe[axisname].TextBox.Text = "0"
		end
		applyTextBoxRotation()
	end)
end

local function chat(message)
	pcall(function()
		local channels = game:GetService("TextChatService"):WaitForChild("TextChannels", 2)
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then general:SendAsync(message) return end
		end
		local chatEvents = game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents", 2)
		if chatEvents then
			local sayMessage = chatEvents:WaitForChild("SayMessageRequest", 2)
			if sayMessage then sayMessage:FireServer(message, "All") end
		end
	end)
end

local function refreshtool(toolname)
	if not toolname then return false end
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(toolname) then
		return false
	end
	local t = LocalPlayer.Backpack:FindFirstChild(toolname)
	if not t then return false end
	t.Parent = LocalPlayer.Character
	while t.Parent == LocalPlayer.Character do
		t.Parent = LocalPlayer.Backpack
		task.wait()
	end
	return true
end

local function equiptool(toolname, equip)
	if not toolname then return false end
	if equip then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(toolname) then return false end
		local item = LocalPlayer.Backpack:FindFirstChild(toolname)
		if not item then return false end
		item.Parent = LocalPlayer.Character
		return true
	else
		if not LocalPlayer.Character then return false end
		local item = LocalPlayer.Character:FindFirstChild(toolname)
		if not item then return false end
		item.Parent = LocalPlayer.Backpack
		return true
	end
end

local function gethrppos()
	return LocalPlayer.Character.HumanoidRootPart.Position
end

local Character = LocalPlayer.Character
local Backpack  = LocalPlayer.Backpack

local confirm = gui.Frame.Buttons.Confirm

local function notify(message, duration, title)
	game:GetService("StarterGui"):SetCore("SendNotification", {
		Title = title or "Rotation Tool",
		Text = message,
		Duration = duration or 5,
	})
end

local function hastool(name)
	return (Character and Character:FindFirstChild(name)) or Backpack:FindFirstChild(name)
end

local function usepainttool(block, material)
	refreshtool("Paint")
	local paint  = hastool("Paint")
	local event  = paint and paint.Script.Event
	if not event then
		notify("Failed to find Paint Tool Event.")
		return
	end
	event:FireServer(block, nil, gethrppos(), "material", nil, material, "")
end

local function rotateblock(part, targetCFrame)
	if part.Anchored then
		notify("Failed to rotate block. Block not unanchored.", 3, "Failed")
		return
	end
	part.CanCollide = false
	local power = 999999
	local hoverpos = Instance.new("BodyPosition")
	local hovergyr = Instance.new("BodyGyro")
	hoverpos.MaxForce = Vector3.new(power, power, power)
	hoverpos.P  = power
	hoverpos.D  = 2500
	hovergyr.MaxTorque = Vector3.new(power, power, power)
	hovergyr.P  = power
	hovergyr.D  = 6200
	hoverpos.Position = targetCFrame.Position
	hovergyr.CFrame   = targetCFrame
	hoverpos.Parent   = part
	hovergyr.Parent   = part
	repeat task.wait() until part.ReceiveAge == 0
	part.CFrame = targetCFrame
	coroutine.wrap(function()
		task.wait(1)
		hoverpos:Destroy()
		hovergyr:Destroy()
	end)()
	task.wait(0.3)
	usepainttool(part, "anchor")
	task.wait(0.3)
	part.CanCollide = true
end

confirm.MouseButton1Click:Connect(function()
	local BLOCK = selectedPart
	local GEAR  = hastool("DaggerOfShatteredDimensions")

	if not BLOCK then
		notify("No block selected.", 3, "Failed") return
	end
	if (BLOCK.Position - gethrppos()).Magnitude > 30 then
		notify("Too far away from the block.", 3, "Failed") return
	end
	if not hastool("Paint") then
		notify("Paint tool not found.", 3, "Failed") return
	end
	if not GEAR then
		notify("Dagger gear not found.", 3, "Failed")
	end
	if not GEAR.Handle.Particle.Flare.Enabled then
		notify("Dagger gear is on cooldown.", 3, "Failed") return
	end

	local targetCFrame = ghostPart.CFrame
	clearSelection()
	notify("Sit back and relax.", 3, "Starting process...")

	if BLOCK.Anchored then
		equiptool("Paint", true)
		usepainttool(BLOCK, "anchor")
		repeat task.wait() until BLOCK.Anchored == false
	end
	GEAR.Remote:FireServer(Enum.KeyCode.Q)
	equiptool("Paint", true)
	task.wait(2)
	usepainttool(BLOCK, "collide")
	task.wait(0.3)
	usepainttool(BLOCK, "collide")
	task.wait(0.3)
	equiptool("Paint", false)
	if workspace:FindFirstChild("Part") and workspace.Part:FindFirstChild("TouchInterest") then
		repeat task.wait() until not workspace:FindFirstChild("Part")
			or not workspace.Part:FindFirstChild("TouchInterest")
	else
		notify("Failed to complete rotation.", 3, "Failed") return
	end
	rotateblock(BLOCK, targetCFrame)
	notify("Rotation complete.", 3, "Success")
end)

