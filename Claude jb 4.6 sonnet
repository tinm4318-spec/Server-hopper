    local function resolveCloneCreatorDisplayName(model)
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local hdn = humanoid.DisplayName
            if hdn and hdn ~= "" and hdn ~= "Humanoid" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.DisplayName == hdn or p.Name == hdn then
                        return p.DisplayName
                    end
                end
                return hdn
            end
        end

        for _, attrName in ipairs({"CreatorName", "OwnerName", "PlayerName", "Owner", "Creator", "Player", "SourcePlayer", "OriginalName"}) do
            local v = model:GetAttribute(attrName)
            if v and type(v) == "string" and v ~= "" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.DisplayName == v or p.Name == v then
                        return p.DisplayName
                    end
                end
                return v
            end
        end

        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("ObjectValue") then
                local val = child.Value
                if val and val:IsA("Player") then
                    return val.DisplayName
                end
            end
        end

        local modelName = model.Name
        local pMatch = modelName:match("^(.-)[%s_]*[Cc]lone%d*$")
        if pMatch and pMatch ~= "" and string.lower(pMatch) ~= "clone" then
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == string.lower(pMatch) or string.lower(p.DisplayName) == string.lower(pMatch) then
                    return p.DisplayName
                end
            end
            return pMatch
        end

        local cMatch = modelName:match("[Cc]lone[%s_of]*([%w_]+)")
        if cMatch and cMatch ~= "" and string.lower(cMatch) ~= "clone" then
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == string.lower(cMatch) or string.lower(p.DisplayName) == string.lower(cMatch) then
                    return p.DisplayName
                end
            end
            return cMatch
        end

        if string.lower(modelName) ~= "clone" then
            return modelName
        end
        return nil
    end

    local function updateCloneList()
        clearCloneScroll()

        local found = {}

        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model")
                and model ~= LocalPlayer.Character
                and model:FindFirstChildOfClass("Humanoid")
                and string.find(string.lower(model.Name), "clone")
            then
                local hasBucket, hasArken = false, false

                pcall(function()
                    for _, desc in ipairs(model:GetDescendants()) do
                        local n = string.lower(desc.Name)
                        if string.find(n, "bucket") or string.find(n, "25162389") then
                            hasBucket = true
                        elseif string.find(n, "arkenstone") then
                            hasArken = true
                        end
                    end
                end)

                if hasBucket or hasArken then
                    local creatorDisplay = resolveCloneCreatorDisplayName(model)
                    local displayName
                    if creatorDisplay then
                        displayName = "Clone(" .. creatorDisplay .. ")"
                    else
                        displayName = model.Name
                    end

                    table.insert(found, {
                        model = model,
                        displayName = displayName,
                        hasArken = hasArken,
                        hasBucket = hasBucket
                    })
                end
            end
        end

        if #found == 0 then
